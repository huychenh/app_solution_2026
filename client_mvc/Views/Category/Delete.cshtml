@using ShopOnline.Common
@model CategoryReadDto

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container-fluid">
    
    <div class="card shadow-sm border-0">

        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Delete Category</h5>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <strong>Warning!</strong> Are you sure you want to delete this category?
            </div>

            <dl class="row mb-0">

                <dt class="col-sm-3 text-muted">
                    Category ID
                </dt>
                <dd class="col-sm-9">
                    @Model.Id
                </dd>

                <dt class="col-sm-3 text-muted">
                    Name
                </dt>
                <dd class="col-sm-9 fw-semibold">
                    @Model.Name
                </dd>

                <dt class="col-sm-3 text-muted">
                    Description
                </dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description available."
                        : Model.Description)
                </dd>

                <dt class="col-sm-3 text-muted">
                    Created Date
                </dt>
                <dd class="col-sm-9">
                    @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")
                </dd>

                <dt class="col-sm-3 text-muted">
                    Updated Date
                </dt>
                <dd class="col-sm-9">
                    @Model.UpdatedDate.ToString("yyyy-MM-dd HH:mm:ss")
                </dd>

            </dl>

        </div>

        <div class="card-footer bg-white text-end">

            <form asp-action="Delete"
                  method="post"
                  class="d-inline">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger">
                    Delete Category
                </button>
            </form>

            <a asp-action="Index"
               class="btn btn-outline-secondary ms-2">
                Back to List
            </a>

        </div>

    </div>

</div>