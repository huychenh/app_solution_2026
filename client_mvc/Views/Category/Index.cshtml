@using ShopOnline.Common
@model IEnumerable<CategoryReadDto>

@{
    ViewData["Title"] = "Categories";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">Manage your categories from here.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Create New
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="border rounded bg-white shadow-sm overflow-hidden" style="min-width: 1100px; overflow-x: auto;">
        
        <div class="d-flex bg-light fw-bold py-3 px-3 border-bottom align-items-center text-muted small uppercase" style="font-size: 0.85rem;">
            <div style="width: 5%;">Id</div>
            <div style="width: 12%;">Name</div>
            <div style="width: 18%;">Description</div>
            <div style="width: 11%;">Created Date</div>
            <div style="width: 11%;">Updated Date</div>
            <div style="width: 10%;">Created By</div>
            <div style="width: 10%;">Updated By</div>
            <div style="width: 8%;">Is Active</div>
            <div style="width: 8%;">Is Deleted</div>
            <div style="width: 11%;" class="text-end">Actions</div>
        </div>

        <div class="d-flex flex-column">
            @foreach (var item in Model)
            {
                <div class="d-flex py-3 px-3 border-bottom align-items-center table-row-hover" style="font-size: 0.9rem;">
                    
                    <div style="width: 5%;">
                        <span class="badge bg-light text-dark border">#@item.Id</span>
                    </div>

                    <div style="width: 12%;" class="fw-semibold text-dark pe-2 text-truncate">
                        @item.Name
                    </div>

                    <div style="width: 18%;" class="text-muted pe-2 text-truncate" title="@item.Description">
                        @(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)
                    </div>

                    <div style="width: 11%;" class="text-secondary">
                        @item.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                    </div>

                    <div style="width: 11%;" class="text-secondary">
                        @item.UpdatedDate.ToString("yyyy-MM-dd HH:mm")
                    </div>

                    <div style="width: 10%;" class="text-dark text-truncate pe-2">
                        @item.CreatedBy
                    </div>

                    <div style="width: 10%;" class="text-dark text-truncate pe-2">
                        @item.UpdatedBy
                    </div>

                    <div style="width: 8%;">
                        @if (item.IsActived)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.75rem;">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size: 0.75rem;">
                                Inactive
                            </span>
                        }
                    </div>

                    <div style="width: 8%;">
                        @if (item.IsDeleted)
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 0.75rem;">
                                Deleted
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.75rem;">
                                Normal
                            </span>
                        }
                    </div>

                    <div style="width: 11%;" class="text-end d-flex gap-1 justify-content-end">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info px-2 py-0" style="font-size: 0.75rem;">
                            Detail
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary px-2 py-0" style="font-size: 0.75rem;">
                            Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger px-2 py-0" style="font-size: 0.75rem;">
                            Delete
                        </a>
                    </div>

                </div>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        No categories available.
    </div>
}

@if (totalPages > 1)
{
    <nav aria-label="Pagination" class="mt-4">
        <ul class="pagination justify-content-center">

            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(currentPage - 1)">
                    Previous
                </a>
            </li>

            @for (var i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(currentPage + 1)">
                    Next
                </a>
            </li>

        </ul>
    </nav>
}

@section Scripts {
    <style>
        .table-row-hover:hover {
            background-color: #f8f9fa;
            transition: background-color 0.15s ease-in-out;
        }
    </style>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const alerts = document.querySelectorAll('.alert-success, .alert-danger');
            alerts.forEach(function (alert) {
                setTimeout(function () {
                    alert.classList.add('fade');
                    setTimeout(function () {
                        alert.remove();
                    }, 150);
                }, 10000);
            });
        });
    </script>
}