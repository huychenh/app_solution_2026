@using ShopOnline.Common
@model IEnumerable<CategoryReadDto>

@{
    ViewData["Title"] = "Categories";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">Manage your categories from here.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">Create New</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
}

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle mb-3">
            <thead class="table-light">
                <tr>                    
                    <th scope="col">Id</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Created Date</th>
                    <th scope="col">Updated Date</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (CategoryReadDto item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td>@item.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@item.UpdatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1">Detail</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info mb-0" role="alert">No categories available.</div>
}

@if (totalPages > 1)
{
    <nav aria-label="Pagination" class="mt-3">
        <ul class="pagination mb-0">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">Previous</a>
            </li>

            @for (var i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                </li>
            }

            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Find all alert elements on the page
            const alerts = document.querySelectorAll('.alert-success, .alert-danger');
            
            alerts.forEach(function (alert) {
                // Set a timer for 10000 milliseconds (10 seconds)
                setTimeout(function () {
                    // Add Bootstrap classes to create a smooth fade-out effect
                    alert.classList.add('fade');
                    
                    // Wait for the fade animation to finish, then remove the element completely
                    setTimeout(function () {
                        alert.remove();
                    }, 150); // 150ms is the standard Bootstrap fade transition time
                    
                }, 10000); 
            });
        });
    </script>
}