@model client_mvc.Models.CategoryUpdateViewModel

@{
    ViewData["Title"] = "Edit Category";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mb-4">
    <h1 class="h3 mb-1">@ViewData["Title"]</h1>
    <p class="text-muted mb-0">Modify the details of the selected category.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Id" class="form-label fw-semibold text-secondary">Category ID</label>
                <input asp-for="Id" class="form-control bg-light text-muted" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Category Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter category name..." />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter optional description..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <hr class="my-4 text-muted" />

            <div class="row mb-3">
                <div class="col-sm-6 mb-3 mb-sm-0">
                    <label asp-for="CreatedDate" class="form-label fw-semibold text-secondary">Created Date</label>
                    <input type="text" class="form-control bg-light text-muted" value="@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")" readonly />
                    <input type="hidden" asp-for="CreatedDate" />
                </div>
                <div class="col-sm-6">
                    <label asp-for="CreatedBy" class="form-label fw-semibold text-secondary">Created By</label>
                    <input asp-for="CreatedBy" class="form-control bg-light text-muted" readonly />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-6 mb-3 mb-sm-0">
                    <label asp-for="UpdatedDate" class="form-label fw-semibold text-secondary">Updated Date</label>
                    <input type="text" class="form-control bg-light text-muted" value="@Model.UpdatedDate.ToString("yyyy-MM-dd HH:mm:ss")" readonly />
                    <input type="hidden" asp-for="UpdatedDate" />
                </div>
                <div class="col-sm-6">
                    <label asp-for="UpdatedBy" class="form-label fw-semibold text-secondary">Updated By</label>
                    <input asp-for="UpdatedBy" class="form-control bg-light text-muted" readonly />
                </div>
            </div>

            <hr class="my-4 text-muted" />

            <div class="mb-3 form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActived">
                <label class="form-check-label fw-semibold" asp-for="IsActived">Is Active</label>
            </div>

            <div class="mb-4 form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" asp-for="IsDeleted">
                <label class="form-check-label fw-semibold text-danger" asp-for="IsDeleted">Is Deleted (Soft Delete)</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>